# Postgres (Neon pelo Marketplace da Vercel, Supabase ou outro). Use a URL "pooled" em produção.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Senha de acesso ao sistema e segredo para assinar o cookie de sessão (texto aleatório longo)
APP_PASSWORD=troque-esta-senha
AUTH_SECRET=gere-um-texto-aleatorio-com-32-caracteres-ou-mais

# Google Places API (New) — console.cloud.google.com → APIs → "Places API (New)"
GOOGLE_PLACES_API_KEY=

# Opcional: nome que aparece no topo
NEXT_PUBLIC_APP_NOME=Prospecta SC
