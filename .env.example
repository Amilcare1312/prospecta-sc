# Postgres (Neon pelo Marketplace da Vercel, Supabase ou outro). Use a URL "pooled" em produção.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Senha de acesso ao sistema e segredo para assinar o cookie de sessão (texto aleatório longo)
APP_PASSWORD=troque-esta-senha
AUTH_SECRET=gere-um-texto-aleatorio-com-32-caracteres-ou-mais

# Google Places API (New) — console.cloud.google.com → APIs → "Places API (New)"
GOOGLE_PLACES_API_KEY=

# Opcional: nome que aparece no topo
NEXT_PUBLIC_APP_NOME=Prospecta SC

# --- Contas de clientes ---
# Login do administrador: e-mail ADMIN_EMAIL (padrão "admin") + APP_PASSWORD
ADMIN_EMAIL=admin
# Dias de teste grátis no cadastro (padrão 7) e estados liberados no teste (vazio = todos)
TESTE_DIAS=7
UFS_TESTE=
# WhatsApp de suporte/vendas (botão "Assinar" quando o teste acaba), ex.: 5548999999999
SUPORTE_WHATSAPP=
# Consultas ao Google por conta por mês (padrão 300). "false" fecha o cadastro público.
GOOGLE_LIMITE_MENSAL=300
CADASTRO_ABERTO=true

# --- Cobrança recorrente (Asaas) ---
# Chave da API (Asaas → Integrações → Chaves de API). Comece no sandbox para testar.
ASAAS_API_KEY=
ASAAS_AMBIENTE=sandbox            # sandbox | producao
ASAAS_WEBHOOK_TOKEN=              # texto aleatório; o mesmo no webhook do Asaas
PRECO_MENSAL=97
PRECO_ANUAL=970                   # deixe vazio para oferecer só o mensal
APP_URL=https://prospecta-sc.vercel.app
EMPRESA_RODAPE=            # ex.: Sua Empresa Ltda · CNPJ 00.000.000/0001-00
